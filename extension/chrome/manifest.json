{
  "manifest_version": 3,
  "name": "MemoryFeed",
  "version": "0.3.0",
  "description": "Local-first social memory capture",
  "action": {
    "default_title": "MemoryFeed",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:7749/*",
    "https://www.facebook.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.youtube.com/*",
    "https://www.linkedin.com/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.youtube.com/*",
        "https://www.linkedin.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
