{
  "manifest_version": 3,
  "name": "MemoryFeed",
  "version": "0.1.0",
  "description": "Local-first social memory capture",
  "action": {
    "default_title": "MemoryFeed",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:7749/*", "https://*/*"],
  "optional_host_permissions": [
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://m.tiktok.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
